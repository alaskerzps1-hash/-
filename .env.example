# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DISCORD_BOT_TOKEN: Discord Bot Token configured via AI Studio Secrets.
# Used server-side only in server.ts to read guild members and roles.
DISCORD_BOT_TOKEN=""

# DISCORD_GUILD_ID: Optional default Discord Server (Guild) ID to sync.
DISCORD_GUILD_ID=""

# DISCORD_CLIENT_ID: Discord Application OAuth2 Client ID (from Discord Developer Portal).
DISCORD_CLIENT_ID=""

# DISCORD_CLIENT_SECRET: Discord Application OAuth2 Client Secret (configured in Secrets).
DISCORD_CLIENT_SECRET=""

# SESSION_SECRET: Secret key used to sign Discord verification cookies.
SESSION_SECRET=""

# DISCORD_ADMIN_IDS: Optional comma-separated Discord User IDs granted Director permissions.
DISCORD_ADMIN_IDS=""

# DISCORD_ADMIN_ROLE_IDS: Optional comma-separated Discord Role IDs granted Director permissions.
DISCORD_ADMIN_ROLE_IDS=""

