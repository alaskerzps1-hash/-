rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }
    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'nomanyosf1@gmail.com';
    }
    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerified() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity Validation Helpers (No existing() or diff() inside)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'employeeCode', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in ['director', 'supervisor', 'staff']
        && (!('employeeCode' in data) || (data.employeeCode is string && data.employeeCode.size() <= 32 && data.employeeCode.matches('^[A-Z0-9\\-]+$')))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'rankTitle', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'rankTitle', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.rankTitle is string && data.rankTitle.size() >= 2 && data.rankTitle.size() <= 80
        && isValidId(data.grantedBy)
        && data.createdAt is timestamp;
    }

    function isValidDepartment(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'sector', 'headName', 'headCode', 'facility', 'visibility', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'code', 'name', 'sector', 'headName', 'headCode', 'facility', 'visibility', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 24 && data.code.matches('^[A-Z0-9\\-]+$')
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.sector is string && data.sector.size() >= 2 && data.sector.size() <= 100
        && data.headName is string && data.headName.size() >= 2 && data.headName.size() <= 120
        && data.headCode is string && data.headCode.size() >= 2 && data.headCode.size() <= 32
        && data.facility is string && data.facility.size() >= 2 && data.facility.size() <= 120
        && data.visibility in ['public', 'restricted']
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['id', 'employeeCode', 'fullName', 'rank', 'rankLevel', 'departmentId', 'departmentName', 'specialization', 'facility', 'status', 'shift', 'extension', 'hireDate', 'visibility', 'notes', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'employeeCode', 'fullName', 'rank', 'rankLevel', 'departmentId', 'departmentName', 'specialization', 'facility', 'status', 'shift', 'extension', 'hireDate', 'visibility', 'notes', 'discordId', 'discordUsername', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.employeeCode is string && data.employeeCode.size() >= 4 && data.employeeCode.size() <= 24 && data.employeeCode.matches('^MOH-[A-Z0-9\\-]+$')
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.rank is string && data.rank.size() >= 2 && data.rank.size() <= 80
        && data.rankLevel is number && data.rankLevel >= 1 && data.rankLevel <= 50
        && isValidId(data.departmentId)
        && data.departmentName is string && data.departmentName.size() >= 2 && data.departmentName.size() <= 120
        && data.specialization is string && data.specialization.size() >= 2 && data.specialization.size() <= 120
        && data.facility is string && data.facility.size() >= 2 && data.facility.size() <= 120
        && data.status in ['active', 'on_leave', 'mission', 'suspended']
        && data.shift in ['morning', "evening", 'night', 'on_call']
        && data.extension is string && data.extension.size() >= 1 && data.extension.size() <= 16 && data.extension.matches('^[0-9\\-]+$')
        && data.hireDate is string && data.hireDate.size() == 10 && data.hireDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.visibility in ['public', 'restricted']
        && data.notes is string && data.notes.size() <= 600
        && (!('discordId' in data) || (data.discordId is string && data.discordId.size() >= 1 && data.discordId.size() <= 40 && data.discordId.matches('^[0-9]+$')))
        && (!('discordUsername' in data) || (data.discordUsername is string && data.discordUsername.size() >= 1 && data.discordUsername.size() <= 100))
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDiscordMapping(data) {
      return data.keys().hasAll(['id', 'guildId', 'discordRoleId', 'discordRoleName', 'rank', 'rankLevel', 'departmentId', 'departmentName', 'autoSync', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'guildId', 'discordRoleId', 'discordRoleName', 'rank', 'rankLevel', 'departmentId', 'departmentName', 'autoSync', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.guildId is string && data.guildId.size() >= 1 && data.guildId.size() <= 40 && data.guildId.matches('^[0-9]+$')
        && data.discordRoleId is string && data.discordRoleId.size() >= 1 && data.discordRoleId.size() <= 40 && data.discordRoleId.matches('^[0-9]+$')
        && data.discordRoleName is string && data.discordRoleName.size() >= 1 && data.discordRoleName.size() <= 120
        && data.rank is string && data.rank.size() >= 2 && data.rank.size() <= 80
        && data.rankLevel is number && data.rankLevel >= 1 && data.rankLevel <= 50
        && isValidId(data.departmentId)
        && data.departmentName is string && data.departmentName.size() >= 2 && data.departmentName.size() <= 120
        && data.autoSync is bool
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDirectorDecision(data) {
      return data.keys().hasAll(['id', 'decisionNumber', 'title', 'type', 'targetEmployeeId', 'targetEmployeeName', 'targetEmployeeCode', 'previousRank', 'newRank', 'effectiveDate', 'summary', 'issuedBy', 'issuedByName', 'createdAt'])
        && data.keys().hasOnly(['id', 'decisionNumber', 'title', 'type', 'targetEmployeeId', 'targetEmployeeName', 'targetEmployeeCode', 'previousRank', 'newRank', 'effectiveDate', 'summary', 'issuedBy', 'issuedByName', 'createdAt'])
        && isValidId(data.id)
        && data.decisionNumber is string && data.decisionNumber.size() >= 8 && data.decisionNumber.size() <= 32 && data.decisionNumber.matches('^DEC-[0-9]{4}-[0-9]+$')
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 160
        && data.type in ['promotion', 'transfer', 'commendation', 'directive', 'suspension']
        && isValidId(data.targetEmployeeId)
        && data.targetEmployeeName is string && data.targetEmployeeName.size() >= 2 && data.targetEmployeeName.size() <= 120
        && data.targetEmployeeCode is string && data.targetEmployeeCode.size() >= 4 && data.targetEmployeeCode.size() <= 24
        && data.previousRank is string && data.previousRank.size() >= 2 && data.previousRank.size() <= 80
        && data.newRank is string && data.newRank.size() >= 2 && data.newRank.size() <= 80
        && data.effectiveDate is string && data.effectiveDate.size() == 10 && data.effectiveDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.summary is string && data.summary.size() >= 3 && data.summary.size() <= 800
        && isValidId(data.issuedBy)
        && data.issuedByName is string && data.issuedByName.size() >= 2 && data.issuedByName.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidRankTier(data) {
      return data.keys().hasAll(['id', 'level', 'title', 'category', 'codeRange', 'authorityScope', 'visibility', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'level', 'title', 'category', 'codeRange', 'authorityScope', 'discordRoleId', 'visibility', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.level is number && data.level >= 1 && data.level <= 50
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 80
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 80
        && data.codeRange is string && data.codeRange.size() >= 3 && data.codeRange.size() <= 60
        && data.authorityScope is string && data.authorityScope.size() >= 3 && data.authorityScope.size() <= 300
        && (!('discordRoleId' in data) || (data.discordRoleId is string && data.discordRoleId.size() <= 40 && data.discordRoleId.matches('^[0-9]*$')))
        && data.visibility in ['public', 'restricted']
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'action', 'targetType', 'targetId', 'targetName', 'targetCode', 'details', 'actorUid', 'actorName', 'createdAt'])
        && data.keys().hasOnly(['id', 'action', 'targetType', 'targetId', 'targetName', 'targetCode', 'details', 'actorUid', 'actorName', 'createdAt'])
        && isValidId(data.id)
        && data.action in ['create_employee', 'update_employee', 'delete_employee', 'promote_employee', 'create_department', 'delete_department', 'create_rank', 'update_rank', 'delete_rank', 'issue_decision', 'grant_admin', 'revoke_admin', 'seed_registry', 'discord_sync', 'update_discord_mapping']
        && data.targetType in ['employee', 'department', 'rank', 'decision', 'admin', 'system', 'discord']
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 64
        && data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 140
        && data.targetCode is string && data.targetCode.size() <= 32
        && data.details is string && data.details.size() >= 1 && data.details.size() <= 500
        && isValidId(data.actorUid)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && data.createdAt is timestamp;
    }

    // Collection: users (PII isolated to owner or director)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(userId)
        && isVerified()
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          incoming().role == 'staff' ||
          (isBootstrappedAdmin() && incoming().role == 'director')
        );
      allow update: if isSignedIn()
        && isValidUserProfile(incoming())
        && isVerified()
        && isValidId(userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'employeeCode', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Collection: admins (Director allowlist)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isBootstrappedAdmin() || (isVerified() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(adminId)
        && isVerified()
        && isValidAdminRecord(incoming())
        && incoming().uid == adminId
        && incoming().grantedBy == request.auth.uid
        && incoming().createdAt == request.time
        && isAdmin();
      allow update: if isSignedIn()
        && isValidAdminRecord(incoming())
        && isVerified()
        && isValidId(adminId)
        && isAdmin()
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'rankTitle']);
      allow delete: if isValidId(adminId) && isAdmin() && adminId != request.auth.uid;
    }

    // Collection: ranks (Configurable Ministry rank tiers)
    match /ranks/{rankId} {
      allow get: if isValidId(rankId) && (existing().visibility == 'public' || isAdmin());
      allow list: if resource.data.visibility == 'public' || isBootstrappedAdmin();
      allow create: if isValidId(rankId)
        && isVerified()
        && isValidRankTier(incoming())
        && isAdmin()
        && incoming().id == rankId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidRankTier(incoming())
        && isVerified()
        && isValidId(rankId)
        && isAdmin()
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['level', 'title', 'category', 'codeRange', 'authorityScope', 'discordRoleId', 'visibility', 'updatedAt']);
      allow delete: if isValidId(rankId) && isAdmin();
    }

    // Collection: departments
    match /departments/{deptId} {
      allow get: if isValidId(deptId) && (existing().visibility == 'public' || isAdmin());
      allow list: if resource.data.visibility == 'public' || isBootstrappedAdmin();
      allow create: if isValidId(deptId)
        && isVerified()
        && isValidDepartment(incoming())
        && isAdmin()
        && incoming().id == deptId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidDepartment(incoming())
        && isVerified()
        && isValidId(deptId)
        && isAdmin()
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['code', 'name', 'sector', 'headName', 'headCode', 'facility', 'visibility', 'updatedAt']);
      allow delete: if isValidId(deptId) && isAdmin();
    }

    // Collection: employees
    match /employees/{employeeId} {
      allow get: if isValidId(employeeId) && (existing().visibility == 'public' || isAdmin());
      allow list: if resource.data.visibility == 'public' || isBootstrappedAdmin();
      allow create: if isValidId(employeeId)
        && isVerified()
        && isValidEmployee(incoming())
        && isAdmin()
        && incoming().id == employeeId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          exists(/databases/$(database)/documents/departments/$(incoming().departmentId)) ||
          existsAfter(/databases/$(database)/documents/departments/$(incoming().departmentId))
        );
      allow update: if isSignedIn()
        && isValidEmployee(incoming())
        && isVerified()
        && isValidId(employeeId)
        && isAdmin()
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          exists(/databases/$(database)/documents/departments/$(incoming().departmentId)) ||
          existsAfter(/databases/$(database)/documents/departments/$(incoming().departmentId))
        )
        && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'employeeCode', 'rank', 'rankLevel', 'departmentId', 'departmentName', 'specialization', 'facility', 'status', 'shift', 'extension', 'hireDate', 'visibility', 'notes', 'discordId', 'discordUsername', 'updatedAt']);
      allow delete: if isValidId(employeeId) && isAdmin();
    }

    // Collection: discordMappings (Discord Role -> MOH Rank mapping)
    match /discordMappings/{mappingId} {
      allow get: if isValidId(mappingId) && (isAdmin() || existing().autoSync == true);
      allow list: if isBootstrappedAdmin() || resource.data.autoSync == true;
      allow create: if isValidId(mappingId)
        && isVerified()
        && isValidDiscordMapping(incoming())
        && isAdmin()
        && incoming().id == mappingId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/departments/$(incoming().departmentId));
      allow update: if isSignedIn()
        && isValidDiscordMapping(incoming())
        && isVerified()
        && isValidId(mappingId)
        && isAdmin()
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/departments/$(incoming().departmentId))
        && incoming().diff(existing()).affectedKeys().hasOnly(['discordRoleName', 'rank', 'rankLevel', 'departmentId', 'departmentName', 'autoSync', 'updatedAt']);
      allow delete: if isValidId(mappingId) && isAdmin();
    }

    // Collection: directorDecisions (Issued by Directors, immutable archive)
    match /directorDecisions/{decisionId} {
      allow get: if isValidId(decisionId) && isAdmin();
      allow list: if isBootstrappedAdmin() || (isVerified() && resource.data.issuedBy == request.auth.uid);
      allow create: if isValidId(decisionId)
        && isVerified()
        && isValidDirectorDecision(incoming())
        && isAdmin()
        && incoming().id == decisionId
        && incoming().issuedBy == request.auth.uid
        && incoming().createdAt == request.time
        && (
          exists(/databases/$(database)/documents/employees/$(incoming().targetEmployeeId)) ||
          existsAfter(/databases/$(database)/documents/employees/$(incoming().targetEmployeeId))
        );
      allow update: if false;
      allow delete: if isValidId(decisionId) && isAdmin();
    }

    // Collection: auditLogs (Immutable administrative trail)
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isBootstrappedAdmin() || (isVerified() && resource.data.actorUid == request.auth.uid);
      allow create: if isValidId(logId)
        && isVerified()
        && isValidAuditLog(incoming())
        && isAdmin()
        && incoming().id == logId
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }
  }
}
